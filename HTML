<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Science Fiction Chess | Cyber Chess</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #000;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        .title {
            text-align: center;
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 30px;
            letter-spacing: 4px;
            text-transform: uppercase;
            background: linear-gradient(90deg, #00ffff, #ff00ff, #00ffff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 3s linear infinite;
        }

        @keyframes shine {
            to { background-position: 200% center; }
        }

        .mode-selection {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
            width: 100%;
            max-width: 800px;
        }

        .mode-btn {
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.7);
            color: #00ffff;
            border: 2px solid #00ffff;
            border-radius: 8px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .mode-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .mode-btn:hover::before {
            left: 100%;
        }

        .mode-btn:hover {
            background: rgba(0, 255, 255, 0.1);
            box-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff;
            transform: translateY(-2px);
        }

        .ai-difficulty {
            display: none;
            flex-wrap: wrap;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
            animation: fadeIn 0.5s ease;
        }

        .ai-difficulty.active {
            display: flex;
        }

        .difficulty-btn {
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.7);
            color: #ff00ff;
            border: 2px solid #ff00ff;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .difficulty-btn:hover {
            background: rgba(255, 0, 255, 0.1);
            box-shadow: 0 0 20px #ff00ff, 0 0 40px #ff00ff;
            transform: translateY(-2px);
        }

        .return-btn {
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.7);
            color: #ff4444;
            border: 2px solid #ff4444;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .return-btn:hover {
            background: rgba(255, 68, 68, 0.1);
            box-shadow: 0 0 20px #ff4444, 0 0 40px #ff4444;
        }

        .range-description {
            display: none;
            text-align: center;
            max-width: 600px;
            padding: 20px;
            border: 2px solid #00ffff;
            border-radius: 10px;
            background: rgba(0, 255, 255, 0.05);
            margin-bottom: 30px;
            animation: fadeIn 0.5s ease;
        }

        .range-description.active {
            display: block;
        }

        .range-description h3 {
            color: #00ffff;
            margin-bottom: 15px;
            font-size: 1.5rem;
        }

        .range-description p {
            color: #ccc;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .chessboard-container {
            display: none;
            flex-direction: column;
            align-items: center;
            animation: fadeIn 0.5s ease;
        }

        .chessboard-container.active {
            display: flex;
        }

        .board-info {
            display: flex;
            justify-content: space-between;
            width: 100%;
            max-width: 500px;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .player-info {
            padding: 8px 16px;
            border-radius: 5px;
            font-weight: bold;
        }

        .player-white {
            color: #00ffff;
            border: 1px solid #00ffff;
            background: rgba(0, 255, 255, 0.1);
        }

        .player-black {
            color: #ff00ff;
            border: 1px solid #ff00ff;
            background: rgba(255, 0, 255, 0.1);
        }

        .turn-indicator {
            color: #fff;
            font-size: 0.9rem;
            align-self: center;
        }

        .chessboard {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(8, 1fr);
            width: 90vw;
            max-width: 500px;
            aspect-ratio: 1;
            border: 3px solid #00ffff;
            box-shadow: 0 0 20px #00ffff, 0 0 40px rgba(0, 255, 255, 0.3);
            position: relative;
        }

        .square {
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.5rem;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }

        .square.light {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
        }

        .square.dark {
            background: linear-gradient(135deg, #0f0f23, #1a1a3e);
        }

        .square:hover {
            filter: brightness(1.3);
        }

        .square.selected {
            background: rgba(0, 255, 255, 0.4) !important;
            box-shadow: inset 0 0 15px #00ffff;
        }

        .square.valid-move::after {
            content: '';
            position: absolute;
            width: 30%;
            height: 30%;
            background: rgba(0, 255, 255, 0.6);
            border-radius: 50%;
            box-shadow: 0 0 10px #00ffff;
        }

        .square.valid-capture {
            box-shadow: inset 0 0 0 4px rgba(255, 0, 255, 0.7);
        }

        .square.last-move {
            box-shadow: inset 0 0 10px rgba(255, 255, 0, 0.5);
        }

        .square.check {
            animation: checkPulse 1s ease infinite;
        }

        @keyframes checkPulse {
            0%, 100% { box-shadow: inset 0 0 20px rgba(255, 0, 0, 0.5); }
            50% { box-shadow: inset 0 0 40px rgba(255, 0, 0, 0.8); }
        }

        .piece {
            font-size: 2.2rem;
            transition: all 0.3s ease;
            user-select: none;
            filter: drop-shadow(0 0 5px currentColor);
        }

        .piece.white {
            color: #00ffff;
            text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
        }

        .piece.black {
            color: #ff00ff;
            text-shadow: 0 0 10px #ff00ff, 0 0 20px #ff00ff;
        }

        .piece.moving {
            animation: pieceMove 0.3s ease;
        }

        @keyframes pieceMove {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); filter: brightness(1.5); }
            100% { transform: scale(1); }
        }

        .piece.captured {
            animation: pieceCapture 0.5s ease forwards;
        }

        @keyframes pieceCapture {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.5); opacity: 0.5; }
            100% { transform: scale(0); opacity: 0; }
        }

        .control-panel {
            display: none;
            margin-top: 20px;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeIn 0.5s ease;
        }

        .control-panel.active {
            display: flex;
        }

        .control-btn {
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            background: rgba(0, 0, 0, 0.7);
            border: 2px solid;
            border-radius: 8px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-restart {
            color: #00ff00;
            border-color: #00ff00;
        }

        .btn-restart:hover {
            background: rgba(0, 255, 0, 0.1);
            box-shadow: 0 0 20px #00ff00, 0 0 40px #00ff00;
        }

        .btn-undo {
            color: #ffff00;
            border-color: #ffff00;
        }

        .btn-undo:hover {
            background: rgba(255, 255, 0, 0.1);
            box-shadow: 0 0 20px #ffff00, 0 0 40px #ffff00;
        }

        .btn-hint {
            color: #ff8800;
            border-color: #ff8800;
        }

        .btn-hint:hover {
            background: rgba(255, 136, 0, 0.1);
            box-shadow: 0 0 20px #ff8800, 0 0 40px #ff8800;
        }

        .promotion-panel {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.95);
            border: 3px solid #00ffff;
            border-radius: 15px;
            padding: 30px;
            z-index: 1000;
            box-shadow: 0 0 50px #00ffff, 0 0 100px rgba(0, 255, 255, 0.3);
            animation: fadeIn 0.3s ease;
        }

        .promotion-panel.active {
            display: block;
        }

        .promotion-panel h3 {
            text-align: center;
            color: #00ffff;
            margin-bottom: 20px;
            font-size: 1.5rem;
            text-shadow: 0 0 10px #00ffff;
        }

        .promotion-options {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        .promotion-piece {
            width: 70px;
            height: 70px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2.5rem;
            border: 2px solid #ff00ff;
            border-radius: 10px;
            cursor: pointer;
            background: rgba(255, 0, 255, 0.1);
            transition: all 0.3s ease;
            color: #00ffff;
            text-shadow: 0 0 10px #00ffff;
        }

        .promotion-piece:hover {
            background: rgba(255, 0, 255, 0.3);
            box-shadow: 0 0 20px #ff00ff, 0 0 40px #ff00ff;
            transform: scale(1.1);
        }

        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 999;
        }

        .overlay.active {
            display: block;
        }

        .game-status {
            margin-top: 15px;
            font-size: 1.2rem;
            text-align: center;
            min-height: 30px;
            color: #00ffff;
            text-shadow: 0 0 10px #00ffff;
        }

        @media (max-width: 600px) {
            .title {
                font-size: 1.8rem;
            }
            
            .mode-btn {
                padding: 10px 20px;
                font-size: 0.9rem;
            }
            
            .piece {
                font-size: 1.8rem;
            }
            
            .square {
                font-size: 2rem;
            }
            
            .control-btn {
                padding: 10px 18px;
                font-size: 0.9rem;
            }
        }

        @media (max-width: 400px) {
            .title {
                font-size: 1.4rem;
            }
            
            .piece {
                font-size: 1.4rem;
            }
            
            .square {
                font-size: 1.5rem;
            }
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
            pointer-events: none;
            z-index: -1;
        }

        .tutorial-content {
            display: none;
            max-width: 700px;
            padding: 25px;
            border: 2px solid #00ffff;
            border-radius: 10px;
            background: rgba(0, 255, 255, 0.05);
            margin-bottom: 30px;
            animation: fadeIn 0.5s ease;
        }

        .tutorial-content.active {
            display: block;
        }

        .tutorial-content h3 {
            color: #00ffff;
            margin-bottom: 15px;
            font-size: 1.5rem;
        }

        .tutorial-content h4 {
            color: #ff00ff;
            margin: 15px 0 8px 0;
        }

        .tutorial-content p, .tutorial-content li {
            color: #ccc;
            line-height: 1.6;
            margin-bottom: 8px;
        }

        .tutorial-content ul {
            margin-left: 20px;
        }

        .captured-pieces {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            min-height: 35px;
            align-items: center;
            font-size: 1.5rem;
        }

        .captured-white {
            color: #00ffff;
            text-shadow: 0 0 5px #00ffff;
        }

        .captured-black {
            color: #ff00ff;
            text-shadow: 0 0 5px #ff00ff;
        }
    </style>
</head>
<body>
    <h1 class="title">Science Fiction Chess | Cyber Chess</h1>

    <div class="mode-selection" id="mainModeSelection">
        <button class="mode-btn" onclick="selectMode('tutorial')">Tutorial Mode</button>
        <button class="mode-btn" onclick="selectMode('range')">Range Mode</button>
        <button class="mode-btn" onclick="selectMode('ai')">AI Battle</button>
        <button class="mode-btn" onclick="selectMode('twoPlayer')">Two-Player Battle</button>
    </div>

    <div class="ai-difficulty" id="aiDifficulty">
        <button class="difficulty-btn" onclick="startGame('ai', 1)">Easy (1 Level)</button>
        <button class="difficulty-btn" onclick="startGame('ai', 3)">Medium (3 Levels)</button>
        <button class="difficulty-btn" onclick="startGame('ai', 5)">Hard (5 Levels)</button>
        <button class="return-btn" onclick="returnToMain()">Return</button>
    </div>

    <div class="range-description" id="rangeDescription">
        <h3>Range Mode</h3>
        <p>Welcome to Range Mode! In this unique game mode, pieces have extended movement ranges based on their type:</p>
        <p><strong style="color:#00ffff">Rooks:</strong> Can move up to 4 squares in any direction (instead of unlimited)</p>
        <p><strong style="color:#ff00ff">Bishops:</strong> Can move up to 4 squares diagonally</p>
        <p><strong style="color:#00ffff">Queens:</strong> Can move up to 5 squares in any direction</p>
        <p><strong style="color:#ff00ff">Knights:</strong> Extended L-shape: can move 3 squares in one direction and 2 in the other</p>
        <p>This mode creates a more tactical, compact battlefield where positioning is key!</p>
        <button class="return-btn" onclick="returnToMain()" style="margin-top:15px;">Return</button>
        <button class="mode-btn" onclick="startGame('range')" style="margin-top:15px; margin-left:10px;">Start Range Game</button>
    </div>

    <div class="tutorial-content" id="tutorialContent">
        <h3>Cyber Chess Tutorial</h3>
        <h4>Basic Rules</h4>
        <ul>
            <li>White moves first, then players alternate turns</li>
            <li>Click a piece to select it, then click a valid destination to move</li>
            <li>Capture opponent pieces by moving onto their square</li>
            <li>Checkmate the enemy king to win!</li>
        </ul>
        <h4>Piece Movements</h4>
        <ul>
            <li><strong>King:</strong> One square in any direction</li>
            <li><strong>Queen:</strong> Any number of squares in any direction</li>
            <li><strong>Rook:</strong> Any number of squares horizontally or vertically</li>
            <li><strong>Bishop:</strong> Any number of squares diagonally</li>
            <li><strong>Knight:</strong> L-shape: 2 squares in one direction, 1 perpendicular</li>
            <li><strong>Pawn:</strong> Forward 1 square (2 on first move), captures diagonally</li>
        </ul>
        <h4>Special Moves</h4>
        <ul>
            <li><strong>Castling:</strong> King and rook swap positions under certain conditions</li>
            <li><strong>En Passant:</strong> Special pawn capture opportunity</li>
            <li><strong>Promotion:</strong> Pawn reaching the end becomes Queen, Rook, Bishop, or Knight</li>
        </ul>
        <button class="return-btn" onclick="returnToMain()" style="margin-top:15px;">Return</button>
        <button class="mode-btn" onclick="startGame('tutorial')" style="margin-top:15px; margin-left:10px;">Practice Game</button>
    </div>

    <div class="chessboard-container" id="chessboardContainer">
        <div class="board-info">
            <div class="player-info player-black" id="blackInfo">Black (AI)</div>
            <div class="turn-indicator" id="turnIndicator">White's Turn</div>
            <div class="player-info player-white" id="whiteInfo">White (You)</div>
        </div>
        <div class="captured-pieces" id="capturedBlack"></div>
        <div class="chessboard" id="chessboard"></div>
        <div class="captured-pieces" id="capturedWhite"></div>
        <div class="game-status" id="gameStatus"></div>
    </div>

    <div class="control-panel" id="controlPanel">
        <button class="control-btn btn-restart" onclick="restartGame()">Restart</button>
        <button class="control-btn btn-undo" onclick="undoMove()">Undo</button>
        <button class="control-btn btn-hint" onclick="showHint()">Hint</button>
        <button class="return-btn" onclick="returnToMain()">Quit to Menu</button>
    </div>

    <div class="overlay" id="overlay"></div>
    <div class="promotion-panel" id="promotionPanel">
        <h3>Choose Promotion</h3>
        <div class="promotion-options">
            <div class="promotion-piece" onclick="promotePawn('q')" title="Queen">♕</div>
            <div class="promotion-piece" onclick="promotePawn('r')" title="Rook">♖</div>
            <div class="promotion-piece" onclick="promotePawn('b')" title="Bishop">♗</div>
            <div class="promotion-piece" onclick="promotePawn('n')" title="Knight">♘</div>
        </div>
    </div>

    <script>
        const PIECES = {
            'K': '♔', 'Q': '♕', 'R': '♖', 'B': '♗', 'N': '♘', 'P': '♙',
            'k': '♚', 'q': '♛', 'r': '♜', 'b': '♝', 'n': '♞
